<group name="local,sysmon,">

  <!-- 100101: Observe PowerShell process creation (Sysmon Event ID 1). -->
  <rule id="100101" level="5">
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <description>PowerShell process creation observed via Sysmon</description>
    <group>sysmon,process_creation,powershell,</group>
  </rule>

  <!-- 100102: Observe cmd.exe process creation (Sysmon Event ID 1). -->
  <rule id="100102" level="5">
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\cmd\.exe$</field>
    <description>Command Prompt process creation observed via Sysmon</description>
    <group>sysmon,process_creation,command_shell,</group>
  </rule>

  <!-- 100103: Observe Sysmon file creation events (Event ID 11). -->
  <rule id="100103" level="5">
    <field name="win.system.eventID">^11$</field>
    <description>Sysmon file creation event observed</description>
    <group>sysmon,file_activity,</group>
  </rule>

  <!-- 100104: Observe registry value set events (Sysmon Event ID 13). -->
  <rule id="100104" level="5">
    <field name="win.system.eventID">^13$</field>
    <description>Sysmon registry value modification observed</description>
    <group>sysmon,registry_activity,</group>
  </rule>

  <!-- 100105: Flag PowerShell launched directly by common Office applications. -->
  <rule id="100105" level="8">
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook)\.exe$</field>
    <description>PowerShell launched by a Microsoft Office application</description>
    <group>sysmon,process_creation,powershell,suspicious_parent,</group>
  </rule>

</group>
